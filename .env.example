# ── Base model ────────────────────────────────────────────────
BASE_MODEL=meta-llama/Llama-3.2-3B
HF_TOKEN=hf_your_token_here

# ── LoRA config ───────────────────────────────────────────────
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.05
LORA_TARGET_MODULES=q_proj,k_proj,v_proj,o_proj,gate_proj,up_proj,down_proj

# ── Quantisation ──────────────────────────────────────────────
USE_4BIT=true
USE_DOUBLE_QUANT=true
QUANT_TYPE=nf4

# ── Training ──────────────────────────────────────────────────
OUTPUT_DIR=./output
DATA_PATH=./data/train.jsonl
EVAL_DATA_PATH=./data/eval.jsonl
PER_DEVICE_BATCH=4
GRAD_ACCUM=4
LEARNING_RATE=2e-4
NUM_EPOCHS=3
WARMUP_RATIO=0.05
MAX_SEQ_LENGTH=2048
USE_PACKING=true
SAVE_STEPS=200
EVAL_STEPS=200
LOGGING_STEPS=25

# ── Dataset format: alpaca | chatml | plain ────────────────────
DATASET_FORMAT=alpaca

# ── Inference / API ───────────────────────────────────────────
ADAPTER_PATH=./lora_adapter
MERGED_PATH=./merged_model
APP_PORT=8000
APP_HOST=0.0.0.0
